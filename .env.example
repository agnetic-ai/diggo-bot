# ==============================================================================
# DIGGO Miner Bot Configuration (.env)
# ==============================================================================

# Target WebApp & Bot Info
BASE_URL=https://diggo.linkpc.net
DEFAULT_REF=ref_0615dd5877f9bdaa953fc770

# ------------------------------------------------------------------------------
# 1. Telegram WebApp Data (initData / tgWebAppData)
# ------------------------------------------------------------------------------
# Anda dapat memasukkan initData langsung di bawah ini.
# Format bisa berupa:
# - Raw string: query_id=...&user=...&hash=...
# - URL lengkap: https://diggo.linkpc.net/#tgWebAppData=query_id%3D...
# - Atau satu akun:
INIT_DATA="query_id=AAH...&user=%7B%22id%22%3A123456789%2C%22first_name%22%3A%22Demo%22%2C%22username%22%3A%22demo_user%22%7D&auth_date=1728000000&hash=abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890"

# Jika multi-akun, Anda bisa menambahkan INIT_DATA_2, INIT_DATA_3, dst:
# INIT_DATA_2="user=...&hash=..."
# INIT_DATA_3="user=...&hash=..."

# Atau format JSON array untuk armada multi-akun:
# ACCOUNTS_INIT_DATA='[
#   {"name": "akun_01", "init_data": "query_id=..."},
#   {"name": "akun_02", "init_data": "query_id=..."}
# ]'

# ------------------------------------------------------------------------------
# 2. Proxy Configuration (Opsional / Rotate)
# ------------------------------------------------------------------------------
# Pilihan PROXY_MODE:
# - none  : Tanpa proxy (koneksi langsung)
# - tor   : Menggunakan Tor SOCKS5 lokal (127.0.0.1:9050) dengan stream isolation per akun
# - list  : Menggunakan daftar proxy di PROXY_LIST (rotasi round-robin)
# - single: Menggunakan satu proxy tunggal di PROXY_URL
PROXY_MODE=none

# Proxy URL tunggal jika PROXY_MODE=single
PROXY_URL=socks5://127.0.0.1:9050

# Tor SOCKS host & port jika PROXY_MODE=tor
TOR_PROXY=socks5://127.0.0.1:9050

# Daftar proxy dipisahkan koma jika PROXY_MODE=list
# PROXY_LIST=http://user:pass@ip1:port,socks5://user:pass@ip2:port

# ------------------------------------------------------------------------------
# 3. Mining & Claim Settings
# ------------------------------------------------------------------------------
# Interval claim mining (dalam jam, default game DIGGO adalah 8 jam)
MINING_INTERVAL_HOURS=8

# Auto claim daily checkin (true/false)
AUTO_DAILY_CHECKIN=true

# Auto claim daily streak (true/false)
AUTO_DAILY_STREAK=true

# Auto claim social tasks (telegram community, x_follow, x_post)
AUTO_TASKS=true

# Jeda antar akun saat memproses fleet (dalam detik)
ACCOUNT_DELAY_SECONDS=3
